# Chingis — environment. Copy to .env; .env is gitignored and never enters a fleet.
# PERSONAL PROJECTS ONLY. Nothing employer-adjacent enters any plane, ever. (Spec §7)

# --- Executive (Phase 1–2): GPT-5.6 Luna via OpenAI API ---
OPENAI_API_KEY=

# --- W2 / GLM fleet: Claude Code headless -> Z.ai endpoint ---
# Consumed by driving the coding plan's own supported tool. Never point raw
# harness code at a plan endpoint. (Spec §0, §4)
ZAI_CODING_ENDPOINT=
ZAI_KEY=

# --- WR raw lane: metered, terms-clean ---
# Z.ai standalone API for GLM-5.2, or OpenRouter for one key across hosts.
ZAI_API_KEY=
OPENROUTER_API_KEY=

# --- W0 local fleet: MLX / LM Studio server ---
MLX_SERVER_URL=http://127.0.0.1:8080

# --- Operator gate. Required to commit under a protected path. (Plan §7 L0) ---
# Do NOT set this persistently. Export it inline, off-cycle, for one commit.
# CHINGIS_OPERATOR=1
