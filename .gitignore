.env
chingis.db
chingis.db-wal
chingis.db-shm
__pycache__/
*.pyc
.venv/
.uv/

# B0 run outputs — regenerable, and may contain worker text.
benchmarks/b0/artifacts/**
benchmarks/b0/results/**
!benchmarks/b0/artifacts/.gitkeep
!benchmarks/b0/results/.gitkeep
!benchmarks/b0/results/*.md

# Disposable worktrees (the blast radius).
.worktrees/

# Session context files auto-dropped by the claude-mem plugin. Tooling artifacts,
# not project content — and they land inside protected paths.
CLAUDE.md
**/CLAUDE.md

# W3 (dsh) lane. The PIN is package.json + package-lock.json, which ARE tracked;
# the tree they install and the vendored Node runtime are build output.
fleets/dsh/node_modules/
fleets/dsh/.runtime/

# Lane run state: dsh session logs live here so they can never enter a worktree
# and ride into a diff. Flywheel data, regenerable, and it carries worker text.
runs/
