  "contracts": [
    {
      "contract_id": "c_0001",
      "seeded": true,
      "defect_class": "deleted_failing_test",
      "injection": {
        "method": "python_sub",
        "file": "backend/tests/test_text_stats.py",
        "precondition": "def test_\\w+",
        "pattern": "(\\n    def test_\\w+\\(self\\))",
        "replacement": "\n    @unittest.skip(\"flaky\")\\1",
        "count": 1
