      "operator_notes": "V1 stays GREEN. If cross-review misses this one, a strong pooled margin means very little."
    },
    {
      "contract_id": "c_0002",
      "seeded": true,
      "defect_class": "off_by_one",
      "injection": {
        "method": "python_sub",
