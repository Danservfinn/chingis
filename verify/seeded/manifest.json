        "precondition": "page_size",
        "pattern": "\\(page - 1\\) \\* page_size",
        "replacement": "page * page_size",
        "count": 1
      },
      "operator_notes": "Fallback pattern if the generator writes the slice differently: see operator note in the plan."
    },
    {
      "contract_id": "c_0003",
